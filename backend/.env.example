# Analytica Backend — Environment Template
# Copy to .env and configure for your environment.

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brazilian_ecommerce_dw
DB_USER=app_user
DB_PASSWORD=change_me

# API
API_TITLE=Analytica
API_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:7860,http://127.0.0.1:7860

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b:free
OPENROUTER_SITE_URL=http://localhost:3000

# Security — set these in production
SECRET_KEY=
ADMIN_TOKEN=

# Cache
CACHE_MAXSIZE=500
CACHE_TTL=60

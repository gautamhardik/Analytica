# Analytica — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Database — use a restricted application user in production, NOT root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brazilian_ecommerce_dw
DB_USER=app_user
DB_PASSWORD=change_me

# OpenRouter (optional — only needed for AI features)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b:free

# CORS — list explicit origins when allow_credentials=true
CORS_ORIGINS=http://localhost:3000,http://localhost:7860,http://127.0.0.1:7860

# Security — set a strong random value for production
SECRET_KEY=
ADMIN_TOKEN=
